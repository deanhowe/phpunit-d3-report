{
  "name": "deanhowe/phpunit-d3-report",
  "description": "A D3.js visualization tool for PHPUnit test results with bubble charts",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Dean Howe",
      "email": "de@n-howe.com"
    }
  ],
  "require": {
    "php": "^5.6.0|^7.0|^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^5.7|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "DeanHowe\\PhpUnitD3Report\\": "src/php/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DeanHowe\\PhpUnitD3Report\\Tests\\": "tests/php/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "gh-pages": "1.0.x-dev",
      "dev-main": "1.0.x-dev"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "suggest": {
    "ext-dom": "Required for parsing PHPUnit XML reports",
    "ext-json": "Required for JSON conversion"
  }
}